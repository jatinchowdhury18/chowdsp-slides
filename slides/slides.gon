title = "ChowDSP Slides"
author = "Jatin Chowdhury"

params = {
    font = "assets/Lato-Regular.ttf"
    code_font = "assets/JetBrainsMono-Regular.ttf"
    footer = {
        height = 4_vh
        style = "PROGRESS_WITH_NUMBER"
    }
}

slides = [
    {
        background_image = "assets/background.jpg"
        background_color = 0x33000000
        style = "Cover"

        title = {
            text = "ChowDSP Slides"
            size = 12_vh
            justification = "Center"
        }

        text = [
            {
                text = "Jatin Chowdhury"
                size = 8_vh
                justification = "Center"
                dims = ["0_vw", "50_vh", "100_vw", "50_vh"]
            },
        ]
    },

    {
        title = {
            text = "Slide #1"
            size = 8_vh
            justification = "Left"
        }

        step_order = ["bullets", "bullets", "bullets", "audio", "eq", "eq", "bullets", "bullets", "bullets", "bullets", "bullets"]

        content = [
            {
                type = "bullet_list"
                id = "bullets"

                frame_params = {
                    dims = ["2_vw", "10_vh", "47_vw", "90_vh"]
                }

                bullets = [
                    {
                        text = "Heading"
                        font_height = "4.5_vh"
                        y_pad = "1.5_vh"
                        justification = "Center"
                        flags = [
                            "BULLET_NO_BULLET",
                            "BULLET_UNDERLINE",
                        ]
                    },
                    {
                        text = "Bullet point #1"
                    },
                    {
                        text = "Bullet point #2"
                    },
                    {
                        text = "sub-bullet point #1"
                        indent = 1
                    },
                    {
                        text = "sub-bullet point #2"
                        indent = 1
                    },
                    {
                        text = "sub-sub-bullet point #1"
                        indent = 2
                    },
                    {
                        text = "sub-sub-bullet point #2, this one should be multi-line"
                        indent = 2
                    },
                    {
                        text = "sub-sub-bullet point #2, this one should be even more lines, like maybe 3? but I guess I'll have to make it longer..."
                        indent = 2
                    },
                ]
            },

            {
                type = "audio_player"
                id = "audio"

                frame_params = {
                    dims = ["51_vw", "10_vh", "47_vw", "25_vh"]
                }

                params = {
                    file_path = "assets/test.wav"
                }
            },

            {
                type = "equation"
                id = "eq"

                frame_params = {
                    dims = ["51_vw", "40_vh", "47_vw", "50_vh"]
                    animate = true
                }

                params = {
                    equations = [
                        {
                            equation = "F(k) = \\int_{-\\infty}^{\\infty} f(x)e^{-2\\pi i k x} \\, dx",
                            height = 50_vh,
                        }
                        {
                            equation = "X[k] = \\sum_{n=0}^{N-1} x[n]e^{-2\\pi i \\frac{k}{N} n}",
                            height = 50_vh,
                        }
                     ]
                    padding = 3_vh
                }
            },
        ]
    },

    {
        background_color = 0xff000000
        title = {
            text = "Bass Face"
            size = 8_vh
            justification = "Left"
        }

        content = [
            {
                type = "image"

                frame_params = {
                    dims = ["12_vw", "20_vh", "76_vw", "68_vh"]
                }

                params = {
                    file_path = "assets/bass face.png"
                    caption = "Stanley Clarke (1991)"
                    link_url = "https://www.youtube.com/watch?v=vLMrenP_nFc"
                }
            },
        ]
    },

    {
        title = {
            text = "Web View Slide"
            size = 8_vh
            justification = "Left"
        }

        content = [
            {
                type = "web"

                frame_params = {
                    dims = ["2_vw", "10_vh", "96_vw", "90_vh"]
                }

                params = {
                    url = "https://compiler-explorer.com"
                }
            }
        ]
    },

    {
        title = {
            text = "More Web Stuff"
            size = 8_vh
            justification = "Left"
        }

        content = [
            {
                type = "web"

                frame_params = {
                    dims = ["2_vw", "10_vh", "47_vw", "90_vh"]
                }

                params = {
                    html = "<html><body style=\"font-family:sans-serif;color:white\"><h1>Hello from embed!</h1><p>This HTML is rendered inside an iframe.</p></body></html>"
                }
            },
            {
                type = "web_img"

                frame_params = {
                    dims = ["51_vw", "10_vh", "47_vw", "44_vh"]
                }

                params = {
                    url = "assets/MJ-giphy.gif"
                }
            },
            {
                type = "youtube"

                frame_params = {
                    dims = ["51_vw", "56_vh", "47_vw", "44_vh"]
                }

                params = {
                    url = "v0yxfVUs1lY",
                }
            },
        ]
    },

    {
        title = {
            text = "Code Slide"
            size = 8_vh
            justification = "Left"
        }

        content = [
            {
                type = "code"
                frame_params = { dims = ["2_vw", "10_vh", "46_vw", "42_vh"] }
                params = {
                    code_file = "assets/code_snippet.cpp",
                    lang = "cpp",
                }
            },
            {
                type = "code"
                frame_params = { dims = ["52_vw", "10_vh", "46_vw", "42_vh"] }
                params = {
                    code_file = "assets/code_snippet.py",
                    lang = "python",
                    theme = "basic-light",
                }
            },
            {
                type = "code"
                frame_params = { dims = ["2_vw", "54_vh", "46_vw", "44_vh"] }
                params = {
                    code_file = "assets/code_snippet.js",
                    lang = "js",
                    theme = "one-dark",
                    font_size = 2.1_vh
                }
            },
            {
                type = "code"
                frame_params = { dims = ["52_vw", "54_vh", "46_vw", "44_vh"] }
                params = {
                    code_file = "assets/code_snippet.jai",
                    lang = "jai",
                    theme = "focus",
                    font_size = 2.75_vh
                }
            }
        ]
    },

    {
        title = {
            text = "Custom Frames"
            size = 8_vh
            justification = "Left"
        }

        content = [
            {
                type = "color_card"
                frame_params = {
                    dims = ["2_vw", "12_vh", "30_vw", "40_vh"]
                    animate = true
                }
                params = {
                    color = 0xff1a73e8
                    label = "Blue"
                    font_size = "6_vh"
                }
            },
            {
                type = "color_card"
                frame_params = {
                    dims = ["35_vw", "12_vh", "30_vw", "40_vh"]
                    animate = true
                }
                params = {
                    color = 0xffe53935
                    label = "Red"
                    font_size = "6_vh"
                }
            },
            {
                type = "color_card"
                frame_params = {
                    dims = ["68_vw", "12_vh", "30_vw", "40_vh"]
                    animate = true
                }
                params = {
                    color = 0xff43a047
                    label = "Green"
                    font_size = "6_vh"
                }
            },
            {
                type = "sine_oscillator"
                frame_params = { dims = ["2_vw", "58_vh", "30_vw", "40_vh"] }
                params = {
                    frequency = 220.0
                    gain = 0.2
                }
            },
        ]
    },
]
